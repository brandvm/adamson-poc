{
  "name": "adamson/media-text",
  "title": "Media and text",
  "description": "Large photo on one side, eyebrow, heading, text, a short list and a button on the other.",
  "icon": "align-pull-left",
  "fields": [
    { "key": "anchor", "type": "text", "label": "Anchor", "help": "Section id for links, without #." },
    { "key": "theme", "type": "select", "label": "Theme", "default": "dark", "options": [ { "label": "Dark", "value": "dark" }, { "label": "Light", "value": "light" } ] },
    { "key": "imagePosition", "type": "select", "label": "Photo side", "default": "left", "options": [ { "label": "Left", "value": "left" }, { "label": "Right", "value": "right" } ] },
    { "key": "eyebrow", "type": "text", "label": "Eyebrow" },
    { "key": "heading", "type": "text", "label": "Heading" },
    { "key": "text", "type": "textarea", "label": "Text" },
    { "key": "points", "type": "repeater", "label": "List", "itemName": "point", "itemLabel": "title",
      "fields": [ { "key": "title", "type": "text", "label": "Title" }, { "key": "text", "type": "text", "label": "Text" } ] },
    { "key": "button", "type": "link", "label": "Button" },
    { "key": "image", "type": "image", "label": "Photo", "help": "Landscape or square, at least 1200px wide." }
  ]
}
