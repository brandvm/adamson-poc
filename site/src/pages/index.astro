---
// Hub for the WebGL studies. The studies themselves are self-contained HTML files in
// /public, served as-is at the same URLs as before.
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const href = (path: string) => base + path;

const studies = [
  {
    title: 'Homepage concept: pinned slider',
    blurb: 'Hero with a sound wave rippling from the driver, the category sentence, then a full-screen slider that steps through the four categories as you scroll.',
    page: 'home/',
    thumb: 'thumbs/home-slider.jpg',
  },
  {
    title: 'Homepage concept: stacked categories',
    blurb: 'The category sentence sticks in the centre while category cards zoom over it on a drum curve, with Chladni sand that re-forms for each card.',
    page: 'home-stack/',
    thumb: 'thumbs/home-stack.jpg',
  },
  {
    title: 'Compression driver',
    blurb: 'Procedural driver face with looping sound-wave shells and Chladni sand. Optional sound.',
    page: 'driver-face-webgl.html',
    thumb: 'thumbs/driver-face.jpg',
  },
  {
    title: 'Line array in the hall',
    blurb: 'Click to send a directional wave from the rig. It flattens against the ceiling, walls and floor.',
    page: 'hall-sound-waves.html',
    thumb: 'thumbs/hall.jpg',
  },
  {
    title: 'Logo intro',
    blurb: 'The mark turns up like volume, stripe by stripe, then the name rises in. Same ease throughout.',
    page: 'logo/',
    thumb: 'thumbs/logo.jpg',
  },
  {
    title: 'Driver build-up',
    blurb: 'The driver face is drawn as a vector, with anchors and handles. A fill sweeps round, then the render resolves into it.',
    page: 'driver-build.html',
    thumb: 'thumbs/driver-build.jpg',
  },
  {
    title: 'Page transition',
    blurb: 'Stripes sweep top-left to bottom-right with the logo intro inside them. Plays into and out of this page only.',
    page: 'transition/',
    thumb: 'thumbs/transition.jpg',
    transition: true,
  },
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href={href('favicon.svg')} />
    <script is:inline src={base + 'transition.js'}></script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400&display=swap" rel="stylesheet" />
    <title>Adamson Studies</title>
  </head>
  <body>
    <header>
      <p class="eyebrow">Adamson · proof of concept</p>
      <h1>WebGL studies</h1>
    </header>

    <main>
      {studies.map((s) => (
        <a class="card" href={href(s.page)} data-transition={s.transition ? true : undefined}>
          <img src={href(s.thumb)} alt="" width="960" height="540" loading="lazy" />
          <span class="text">
            <span class="title">{s.title}</span>
            <span class="blurb">{s.blurb}</span>
          </span>
        </a>
      ))}
    </main>
  </body>
</html>

<style>
  :global(html) { background: #000; }
  :global(body) {
    margin: 0; min-height: 100vh; background: #000; color: #e9e2d8;
    font-family: 'Outfit', system-ui, sans-serif; font-weight: 300;
    padding: clamp(24px, 6vw, 80px) clamp(16px, 5vw, 72px);
    box-sizing: border-box;
  }
  header { margin-bottom: clamp(28px, 5vw, 56px); }
  .eyebrow { margin: 0 0 .8em; color: #ab9981; letter-spacing: .32em; text-transform: uppercase; font-size: 12px; }
  h1 { margin: 0; font-weight: 300; font-size: clamp(32px, 5vw, 56px); letter-spacing: -.01em; }
  main { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 420px), 1fr)); gap: clamp(16px, 2.5vw, 32px); }
  .card {
    display: block; color: inherit; text-decoration: none; border-radius: 14px; overflow: hidden;
    border: 1px solid rgba(171, 153, 129, .22); background: #0a0908;
    transition: border-color .25s ease, transform .25s cubic-bezier(.2, .7, .2, 1);
  }
  .card:hover { border-color: rgba(171, 153, 129, .7); transform: translateY(-2px); }
  .card:focus-visible { outline: 1px solid #ab9981; outline-offset: 3px; }
  img { display: block; width: 100%; height: auto; aspect-ratio: 16 / 9; object-fit: cover; }
  .text { display: block; padding: 18px 20px 22px; }
  .title { display: block; font-size: 20px; font-weight: 400; margin-bottom: 6px; }
  .blurb { display: block; color: #a89f93; font-size: 15px; line-height: 1.5; }
  @media (prefers-reduced-motion: reduce) { .card { transition: none; } .card:hover { transform: none; } }
</style>
