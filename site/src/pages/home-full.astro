---
// Homepage concept C, from Figma "Home" (463:596) as the section guide: the hero, then the
// full-viewport category slider (660:9625) straight away, with no sentence in between, then
// Products. The later sections of the guide (Applications, Technology…) aren't built yet.
import HomeLayout from '../layouts/HomeLayout.astro';
import Header from '../components/home/Header.astro';
import Hero from '../components/home/Hero.astro';
import HeardAt from '../components/home/HeardAt.astro';
import FeatureSlider from '../components/home/FeatureSlider.astro';
import ProductsSection from '../components/home/ProductsSection.astro';
import LetsConnect from '../components/home/LetsConnect.astro';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<HomeLayout title="Adamson · Homepage concept (full-screen slider)" description="Homepage concept for Adamson Systems Engineering: hero, then a full-viewport category slider and the Products section.">
  <Header />
  <main>
    <div class="first-screen" data-theme="dark">
      <Hero />
      <HeardAt />
    </div>
    <FeatureSlider />
    <ProductsSection />
    <LetsConnect />
    <section class="end" data-theme="light">
      <p>Concept ends here. Next sections: Applications, Products in action, Technology…</p>
      <p><a href={base + 'home-stack/'}>Compare: sentence with category cards over it</a></p>
    </section>
  </main>
</HomeLayout>
