---
// Homepage concept B: the sentence stays pinned in the centre and the featured products
// scroll up over it one at a time (reference: uncommondesign.group work section).
import HomeLayout from '../layouts/HomeLayout.astro';
import Header from '../components/home/Header.astro';
import Hero from '../components/home/Hero.astro';
import HeardAt from '../components/home/HeardAt.astro';
import CategoryStack from '../components/home/CategoryStack.astro';
import ProductsSection from '../components/home/ProductsSection.astro';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<HomeLayout title="Adamson · Homepage concept (stack)" description="Homepage concept for Adamson Systems Engineering: the category sentence stays in the centre while featured products scroll over it.">
  <Header />
  <main>
    <div class="first-screen" data-theme="dark">
      <Hero />
      <HeardAt />
    </div>
    <CategoryStack />
    <ProductsSection />
    <section class="end" data-theme="light">
      <p>Concept ends here. Next sections: Products in action, Applications, Technology…</p>
      <p><a href={base + 'home/'}>Compare: pinned full-screen slider</a></p>
    </section>
  </main>
</HomeLayout>
