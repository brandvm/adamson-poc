---
// Standalone study: the "Timeline" section on its own page.
import HomeLayout from '../layouts/HomeLayout.astro';
import Timeline from '../components/home/Timeline.astro';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<HomeLayout title="Adamson · Timeline" description="Adamson's milestones: stacked years, arrows or swipe to step through.">
  <main class="solo">
    <Timeline />
  </main>
  <a class="back" href={base}>← Studies</a>
</HomeLayout>

<style>
  .solo { min-height: 100vh; display: grid; align-content: center; background: #000; }
  .back {
    position: fixed; top: 1.25em; left: 1.25em; z-index: 50; padding: 0.6em 1.1em; border-radius: 999px;
    border: 1px solid rgba(171, 153, 129, 0.35); background: rgba(0, 0, 0, 0.4); backdrop-filter: blur(6px);
    color: var(--gold-light); text-decoration: none; font: 400 0.6875em/1 var(--font); letter-spacing: 0.24em; text-transform: uppercase;
  }
  .back:hover { border-color: var(--gold-light); }
</style>
