---

<svg
  class:list={['adamson-logo', { 'is-animated': animate }]}
  style={`--logo-color:${color}; width:${width};`}
  viewBox="0 0 600 580"
  role="img"
  aria-label={label}
  xmlns="http://www.w3.org/2000/svg"
>
  <defs>
    {letters.map((l, i) => (
      <clipPath id={`${uid}-l${i}`}><rect x={l.x - 1} y="474" width={l.w + 2} height="108" /></clipPath>
    ))}
  </defs>

  <g class="mark">
    <path fill-rule="evenodd" clip-rule="evenodd" d="M218.35 262.58L351.95 31.18L333.95 0L68.7695 459.3H83.8695L207.9 244.48L218.35 262.58ZM240.85 301.55L374.45 70.15L356.45 38.97L113.77 459.3H128.87L230.4 283.45L240.85 301.55ZM263.35 340.52L396.95 109.12L378.95 77.94L158.77 459.3H173.87L252.9 322.42L263.35 340.52ZM285.85 379.49L419.45 148.09L401.45 116.91L203.77 459.3H218.87L275.4 361.39L285.85 379.49ZM308.35 418.46L441.95 187.06L423.95 155.88L248.77 459.3H263.87L297.9 400.36L308.35 418.46ZM330.85 457.44L464.45 226.03L446.45 194.86L293.77 459.3H308.87L320.4 439.34L330.85 457.44ZM338.77 459.3H374.77L486.95 265L468.95 233.83L338.77 459.3ZM383.77 459.3H419.77L509.45 303.98L491.45 272.8L383.77 459.3ZM428.77 459.3H464.77L531.95 342.95L513.95 311.77L428.77 459.3ZM473.77 459.3H509.77L554.45 381.92L536.45 350.74L473.77 459.3ZM518.77 459.3H554.77L576.95 420.89L558.95 389.71L518.77 459.3ZM581.45 428.68L563.77 459.3H599.13L581.45 428.68Z" />
  </g>

  <g class="word">
    {letters.map((l, i) => (
      <g clip-path={`url(#${uid}-l${i})`}>
        <g class="letter" style={`--i:${i}; --w:${l.w + 2}px;`}>
          <path fill-rule="evenodd" clip-rule="evenodd" d={l.d} />
        </g>
      </g>
    ))}
  </g>
</svg>

<script is:inline>
  // Restart the intro on a given logo (or all logos on the page).
  window.replayLogo = function (el) {
    const logos = el ? [el] : document.querySelectorAll('.adamson-logo.is-animated');
    logos.forEach((svg) => {
      svg.classList.remove('is-animated');
      void svg.getBoundingClientRect();   // force a style flush so the animation restarts
      svg.classList.add('is-animated');
    });
  };
</script>

<style>
  .adamson-logo {
    --ease: cubic-bezier(0.64, 0.05, 0, 1);
    --mark-dur: 1.6s;
    --word-dur: 0.9s;       /* each letter */
    --stagger: 0.04s;       /* gap between letters, left to right */
    /* start the name so its last letter (N, index 6) lands exactly as the mark finishes */
    --word-delay: calc(var(--mark-dur) - var(--word-dur) - 6 * var(--stagger));
    --slide: 0.35;          /* how far each letter travels, as a fraction of its width */
    display: block; height: auto; max-width: 100%; overflow: visible;
    fill: var(--logo-color);
  }

  /* 1 ── volume up: a triangle the same shape as the mark, anchored at its bottom-right
     corner, grows from nothing to full size. Percentages are of the mark's own box. */
  .is-animated .mark {
    animation: adamson-volume var(--mark-dur) var(--ease) both;
  }
  @keyframes adamson-volume {
    from { clip-path: polygon(101% 101%, 101% 101%, 101% 101%); }
    to   { clip-path: polygon(50% -2%, -2% 101%, 101% 101%); }
  }

  /* 2 ── the name: each letter slides in from the left inside its own mask, left to right */
  .is-animated .letter {
    animation: adamson-letter var(--word-dur) var(--ease) calc(var(--word-delay) + var(--i) * var(--stagger)) both;
  }
  /* short slide + a left-to-right wipe on the letter itself, so it still starts fully hidden */
  @keyframes adamson-letter {
    from { transform: translateX(calc(var(--w) * var(--slide) * -1)); clip-path: inset(-2% 100% -2% 0); }
    to   { transform: translateX(0);                                   clip-path: inset(-2% -2% -2% 0); }
  }

  @media (prefers-reduced-motion: reduce) {
    .is-animated .mark, .is-animated .letter { animation: none; }
  }
</style>
