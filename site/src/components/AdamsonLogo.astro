---
/**
 * Adamson logo with a "volume up" intro.
 *
 * 1. The striped mark is revealed by a triangular window anchored at its bottom-right
 *    corner that grows to full size, so the stripes appear right-to-left like a volume ramp.
 * 2. Then ADAMSON slides in letter by letter, left to right, each letter masked to its own box.
 * Both use cubic-bezier(0.64, 0.05, 0, 1).
 *
 * Props:
 *   animate  – play the intro on load (default true). Re-run it with `replayLogo(el)`.
 *   color    – fill colour (default logo gold #816D4D).
 *   width    – CSS width (default 320px).
 *   label    – accessible name (default "Adamson").
 */
interface Props { animate?: boolean; color?: string; width?: string; label?: string }
const { animate = true, color = '#816D4D', width = '320px', label = 'Adamson' } = Astro.props;

// unique ids so several logos can sit on one page
const uid = 'al' + Math.random().toString(36).slice(2, 8);

// ADAMSON split into letters (x/w = each letter's box in logo units) so each can slide in on its own
const letters = [
