    "x": 153.91,
    "w": 87.99
  },
  {
    "ch": "M",
    "d": "M248.55 480.1H262.46L298.15 561.26L333.84 480.1H347.75V577.6H338.15V493.72L301.27 577.6H295.03L258.15 493.72V577.6H248.55V480.1Z",
    "x": 248.55,
    "w": 99.2
  },
  {
    "ch": "S",
    "d": "M405.24 504.55C405.352 499.804 404.134 495.122 401.724 491.032C399.315 486.942 395.809 483.608 391.604 481.405C387.399 479.203 382.662 478.221 377.928 478.569C373.194 478.918 368.652 480.584 364.814 483.378C360.977 486.173 357.998 489.985 356.214 494.383C354.429 498.782 353.91 503.592 354.716 508.27C355.522 512.948 357.62 517.308 360.773 520.856C363.926 524.404 368.009 527 372.56 528.35L384.77 531.97C388.101 532.959 391.092 534.856 393.405 537.45C395.718 540.044 397.263 543.231 397.866 546.653C398.469 550.076 398.106 553.599 396.818 556.827C395.53 560.055 393.368 562.86 390.575 564.927C387.782 566.995 384.467 568.243 381.004 568.532C377.541 568.821 374.065 568.139 370.968 566.563C367.871 564.987 365.274 562.579 363.469 559.609C361.664 556.639 360.722 553.225 360.75 549.75H351.35C351.322 554.969 352.749 560.092 355.47 564.546C358.19 568.999 362.098 572.607 366.753 574.965C371.409 577.323 376.63 578.338 381.83 577.896C387.03 577.454 392.004 575.572 396.195 572.462C400.386 569.352 403.628 565.136 405.558 560.287C407.488 555.438 408.029 550.148 407.121 545.008C406.213 539.869 403.892 535.084 400.417 531.19C396.943 527.296 392.453 524.446 387.45 522.96L375.23 519.34C372.352 518.485 369.771 516.84 367.781 514.591C365.791 512.342 364.472 509.581 363.974 506.62C363.475 503.659 363.817 500.618 364.961 497.841C366.104 495.065 368.004 492.665 370.443 490.915C372.883 489.164 375.764 488.133 378.76 487.938C381.757 487.744 384.747 488.394 387.393 489.814C390.038 491.234 392.232 493.368 393.725 495.973C395.219 498.578 395.951 501.549 395.84 504.55H405.24Z",
