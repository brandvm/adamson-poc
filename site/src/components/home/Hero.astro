---
import SoundWaves from './SoundWaves.astro';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const a = (f: string) => `${base}home/${f}`;
---

<section class="hero" aria-labelledby="hero-title" style={`--mask: url(${a('hero-wordmark-mask.svg')})`}>
  <div class="stage">
    <img class="glow gold" src={a('glow-gold.svg')} alt="" />
    <img class="glow grey" src={a('glow-grey.svg')} alt="" />

    <!-- Frosted ADAMSON: three exported layers, each under the same top-to-bottom fade -->
    <div class="wordmark" aria-hidden="true">
      <img class="soft" src={a('hero-wordmark-1.svg')} alt="" />
      <img src={a('hero-wordmark-2.svg')} alt="" />
      <img class="soft" src={a('hero-wordmark-3.svg')} alt="" />
    </div>

    <img class="speaker" src={a('exploded-speaker.png')} alt="Exploded view of the Adamson M140 compression driver" width="1673" height="940" />

    <!-- Click the hero: a directional sound wave leaves the gold dome (same physics as the driver study) -->
    <SoundWaves />

    <div class="content">
      <h1 id="hero-title">Adamson Systems Engineering:<br />Professional Loudspeaker Systems</h1>
      <p>Loudspeaker systems designed and built in Canada since 1984, from the world's biggest tours to theatres, stadiums and houses of worship.</p>
      <div class="buttons">
        <a class="btn btn-primary" href="#categories">Explore Systems</a>
        <a class="btn btn-glass" href="#">Find Your Local Team</a>
      </div>
    </div>
  </div>

  <!-- Custom cursor over the hero until the first click (fine pointers only) -->
  <div class="hero-cursor" aria-hidden="true"><span>Click</span></div>
</section>

<style>
  /* Figma "Home - Section - Hero" 627:4878: 96px top for the header, 20px frame, 1640 × 908 stage */
  .hero { display: flex; flex-direction: column; padding: 6em 1.25em 1.25em; }
  /* Fills the space left in the first screen; children size from its width and height (cq units) */
  .stage {
    position: relative; isolation: isolate; overflow: hidden; flex: 1; min-height: 0;
    container-type: size;
    border-radius: 1.25em 1.25em 0 0; background: #0a0a0a;
  }
  /* Bottom fade into the next section (Figma "Section Transition") */
  .stage::after {
    content: ''; position: absolute; inset: auto 0 0; height: 30.5%; pointer-events: none;
    background: linear-gradient(to top, #000 24%, transparent);
  }

  .glow { position: absolute; max-width: none; pointer-events: none; }
  .glow.gold { width: 132.375em; left: -66.1875em; top: -60.5625em; }
  .glow.grey { width: 107.375em; right: -53.6875em; top: -48.0625em; }

  /* On the 1520px (95em) container, aligned with the hero text. Centred with auto margins,
     not a transform: a transform would isolate the soft-light layers (see below). */
  .wordmark {
    position: absolute; inset: 2.2% 0 auto; margin-inline: auto;
    width: min(var(--container), 100% - 7.5em); aspect-ratio: 1640 / 276.527;
  }
  /* Mask each layer, not the wrapper: masking the wrapper isolates it, and the
     soft-light layers would then blend with nothing and render flat white. */
  .wordmark img {
    position: absolute; inset: 0; width: 100%; height: 100%;
    -webkit-mask: var(--mask) top / 100% 100% no-repeat; mask: var(--mask) top / 100% 100% no-repeat;
  }
  .wordmark .soft { mix-blend-mode: soft-light; }

  /* Figma splits this render into two rotated crops; together they are the whole image,
     rotated 8.46° and centred at 50.34% / 56.2% of the 1640 × 908 stage (103% of its width).
     Sized from the shorter side so it keeps that framing on any screen shape. */
  .speaker {
    position: absolute; left: 50.34%; top: 56.2%; width: min(103cqw, 186cqh); max-width: none; height: auto;
    transform: translate(-50%, -50%) rotate(8.46deg); pointer-events: none;
    /* Floats: a slow bob and a slower, slight tilt on separate cycles so the motion never quite
       repeats. Uses the individual translate/rotate properties, which add to the transform. */
    animation: float-y 7s ease-in-out infinite, float-r 11s ease-in-out infinite;
  }
  @keyframes float-y { 50% { translate: 0 -0.625em; } }
  @keyframes float-r { 0%, 100% { rotate: -0.25deg; } 50% { rotate: 0.3deg; } }
  @media (prefers-reduced-motion: reduce) { .speaker { animation: none; } }

  /* ---- "Click" cursor ---- */
  .stage.has-cursor { cursor: none; }
  .stage.has-cursor :is(a, button) { cursor: pointer; }
  .hero-cursor {
    position: fixed; left: 0; top: 0; z-index: 30; pointer-events: none;
    width: 5em; aspect-ratio: 1; border-radius: 50%; display: grid; place-items: center;
    background: rgba(10, 10, 10, 0.35); border: 1px solid rgba(255, 255, 255, 0.35);
    -webkit-backdrop-filter: blur(8px); backdrop-filter: blur(8px);
    transform: translate3d(var(--x, -100px), var(--y, -100px), 0) translate(-50%, -50%) scale(var(--cs, 0.4));
    opacity: 0; transition: opacity 0.25s ease, --cs 0.25s ease;
  }
  .hero-cursor.is-on { opacity: 1; --cs: 1; }
  .hero-cursor span { font: 500 0.75em/1 var(--font); letter-spacing: 0.12em; text-transform: uppercase; color: #fff; }
  /* A soft gold ring keeps leaving the cursor, hinting at the sound wave */
  .hero-cursor::after {
    content: ''; position: absolute; inset: -1px; border-radius: 50%;
    border: 1px solid rgba(201, 168, 119, 0.6); animation: cursor-ping 1.8s ease-out infinite;
  }
  @keyframes cursor-ping { from { transform: scale(1); opacity: 0.9; } to { transform: scale(1.7); opacity: 0; } }
  @media (prefers-reduced-motion: reduce) { .hero-cursor::after { animation: none; } }
  @property --cs { syntax: '<number>'; inherits: false; initial-value: 0.4; }

  /* Content sits on the 1520px (95em) container: 60px in from the 1640 stage at the frame */
  .content {
    position: absolute; z-index: 1; bottom: 3em; left: 50%; transform: translateX(-50%);
    width: min(var(--container), 100% - 7.5em);
    display: grid; justify-items: start; gap: 0.75em;
  }
  .content > * { max-width: 25em; }
  h1 { margin: 0; font: 400 1.5em/1.32 var(--font); letter-spacing: -0.024em; }
  .content p { margin: 0; font: 300 1em/1.4 var(--font); opacity: 0.48; }
  .buttons { display: flex; flex-wrap: wrap; gap: 1em; margin-top: 0.75em; }

  @media (max-width: 991px) {
    .hero { padding: 4.5em 0.75em 0.75em; }
    .stage { container-type: normal; display: grid; padding: 22% 1.5em 2em; }
    .wordmark { inset: 1.5em 0 auto; width: calc(100% - 3em); }
    .speaker { position: relative; left: 50%; top: auto; width: 150%; max-width: none; margin: -6% 0 -14%; transform: translateX(-50%) rotate(8.46deg); }
    .content { position: relative; left: auto; bottom: auto; width: auto; transform: none; }
  }
</style>

<script>
  // "Click" cursor: follows the pointer over the hero panel (eased), steps aside for the hero's
  // links and buttons, and retires for good after the first click on the panel.
  const stage = document.querySelector<HTMLElement>('.hero .stage');
  const cur = document.querySelector<HTMLElement>('.hero-cursor');
  if (stage && cur && matchMedia('(hover: hover) and (pointer: fine)').matches) {
    stage.classList.add('has-cursor');
    let x = -100, y = -100, tx = -100, ty = -100, raf = 0, done = false;
    const follow = () => {
      x += (tx - x) * 0.25; y += (ty - y) * 0.25;
      cur.style.setProperty('--x', `${x.toFixed(1)}px`); cur.style.setProperty('--y', `${y.toFixed(1)}px`);
      raf = Math.abs(tx - x) + Math.abs(ty - y) > 0.3 ? requestAnimationFrame(follow) : 0;
    };
    const onMove = (e: PointerEvent) => {
      if (done) return;
      tx = e.clientX; ty = e.clientY;
      if (!cur.classList.contains('is-on')) { x = tx; y = ty; }           // appear where the pointer is
      cur.classList.toggle('is-on', !(e.target as Element).closest('a, button'));
      if (!raf) raf = requestAnimationFrame(follow);
    };
    stage.addEventListener('pointermove', onMove);
    stage.addEventListener('pointerleave', () => cur.classList.remove('is-on'));
    stage.addEventListener('click', (e) => {
      if (done || (e.target as Element).closest('a, button')) return;
      done = true;
      cur.classList.remove('is-on');
      stage.classList.remove('has-cursor');
      stage.removeEventListener('pointermove', onMove);
    });
  }
</script>
