---
import { nav } from '../../data/home';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const a = (f: string) => `${base}home/${f}`;
---

<header class="header">
  <a class="logo" href={base}><img src={a('logo-mark.png')} alt="Adamson" width="59" height="59" /></a>

  <nav aria-label="Main">
    <ul>
      {nav.map((n) => (
        <li><a href="#" class:list={{ more: n.dropdown }}>{n.label}</a></li>
      ))}
      <li><button class="search" type="button" aria-label="Search"><img src={a('icon-search.svg')} alt="" width="18" height="18" /></button></li>
    </ul>
  </nav>

  <div class="actions">
    <button class="lang more" type="button">EN</button>
    <a class="login" href="#"><img src={a('icon-user.svg')} alt="" width="20" height="20" />Login</a>
    <a class="btn btn-contrast" href="#">Contact Us</a>
  </div>
</header>

<style define:vars={{ chevron: `url(${a('icon-chevron.svg')})` }}>
  /* Figma "Header" 486:218 — 96px tall; content on the 1520px (95em) container */
  .header {
    position: absolute; inset: 0 0 auto; z-index: 20; height: 6em;
    padding-inline: max(var(--margin), (100% - var(--container)) / 2);
    display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; background: #000;
  }
  .logo img { width: 3.6875em; height: auto; }
  nav ul { display: flex; align-items: center; gap: 2em; }
  .actions { justify-self: end; display: flex; align-items: center; gap: 0.5em; }

  nav a, .lang, .login {
    display: inline-flex; align-items: center; gap: 0.4286em; height: 2.8571em; padding: 0 1em;
    border: 0; border-radius: 999px; background: none; cursor: pointer;
    font: 400 0.875em/1.4286 var(--font); letter-spacing: -0.01em; color: #fff; text-decoration: none;
  }
  .more::after { content: ''; width: 0.8571em; aspect-ratio: 1; background: var(--chevron) center / contain no-repeat; }
  .login { font-weight: 500; gap: 0.5714em; padding: 0 1.1429em; }
  .login img { width: 1.4286em; height: auto; }
  nav a:hover, .lang:hover, .login:hover { color: var(--gold-light); }
  .search { display: grid; place-items: center; width: 2.375em; aspect-ratio: 1; border: 0; border-radius: 999px; background: none; cursor: pointer; }
  .search img { width: 1.125em; height: auto; }

  @media (max-width: 991px) {
    .header { grid-template-columns: auto 1fr; height: 4.5em; }
    nav, .lang, .login { display: none; }
    .logo img { width: 2.75em; }
  }
</style>
