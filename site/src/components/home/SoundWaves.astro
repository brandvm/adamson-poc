---
// Clicking the hero sends a sound wave from the gold dome of the driver: a glassy ring that grows
// past the edges of the hero, with the same directional physics as the driver study
// (public/driver-face-webgl.html):
//   - the wave travels in the direction the dome faces. The hero render doesn't move, so that
//     direction is fixed (a little to the left, as the dome is turned in the image) and the
//     pointer doesn't steer it, unlike the study;
//   - the ring's centre travels along that direction as it grows, and it's brighter on that side;
//   - the rim profile (soft outer step, glow just inside the edge, milky veil, faint second
//     surface) is the study's, measured from the reference clip.
// The hero's whole panel ripples as the rim passes, like the study's refraction: an SVG
// displacement filter on the panel bends its rendered image (wordmark, driver, headline, text,
// buttons) along a band just inside the rim. The filter is only applied while a wave is out.
// The current wave is shared on window.__adamsonWave so the Chladni sand can react to it.
// Drawn on its own canvas with screen blending, over the driver. Needs a sibling `.speaker` image.
interface Props { class?: string }
const { class: className } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<canvas class:list={['sound-waves', className]} aria-hidden="true"></canvas>

<!-- Ripple: a radial "outward" map, masked to the rim band, over neutral grey, displaces the panel -->
<svg class="ripple-defs" width="0" height="0" aria-hidden="true" focusable="false">
  <filter id="hero-ripple" x="0" y="0" width="1" height="1" primitiveUnits="userSpaceOnUse" color-interpolation-filters="sRGB">
    <feFlood flood-color="rgb(128,128,128)" result="neutral" />
    <feImage class="ripple-dir" href={`${base}home/wave-direction-map.png`} preserveAspectRatio="none" x="0" y="0" width="1" height="1" result="dir" />
    <feImage class="ripple-mask" href={`${base}home/wave-ring-mask.png`} preserveAspectRatio="none" x="0" y="0" width="1" height="1" result="mask" />
    <feComposite in="dir" in2="mask" operator="in" result="ring" />
    <feComposite in="ring" in2="neutral" operator="over" result="map" />
    <feDisplacementMap class="ripple-disp" in="SourceGraphic" in2="map" scale="0" xChannelSelector="R" yChannelSelector="G" />
  </filter>
</svg>

<style>
  .sound-waves {
    position: absolute; inset: 0; width: 100%; height: 100%; display: block; pointer-events: none;
    mix-blend-mode: screen;   /* black = no change; the rings add light */
  }
  .ripple-defs { position: absolute; width: 0; height: 0; overflow: hidden; }
</style>

<script>
  // Dome of the gold mesh in exploded-speaker.png (1673 × 940), measured from the image.
  const IMG_W = 1673, IMG_H = 940;
  const DOME = { x: 689, y: 507, r: 160 };   // centre and (vertical) radius, image px
  const LIFE = 3.4;                            // seconds a wave takes to clear the hero (study's loop)
  // Direction the dome faces in the render, as the study's face-normal xy (|axis| ≤ sin 24°):
  // a little to the left and slightly up.
  const AXIS: [number, number] = [-0.35, 0.05];

  const FRAG = `
    precision highp float;
    uniform vec2 uC;      // dome centre, device px (GL coords, y up)
    uniform float uK;     // device px per reference unit (dome radius = 201 units, as in the study)
    uniform float uR;     // ring radius, reference units
    uniform float uEnv;   // fade in/out
    uniform vec2 uAxis;   // direction latched at emission (study's face normal xy)
    uniform float uSeed;
    void main(){
      vec2 p = (gl_FragCoord.xy - uC) / uK;
      float aa = 0.9 / uK;
      float axisL = length(uAxis);
      vec2 axisN = axisL > 1e-4 ? uAxis / axisL : vec2(0.);
      float R = uR;
      vec2 cen = uAxis * R * 0.62;                 // a sphere travelling along the axis
      vec2 dv = p - cen; float r = length(dv);
      vec2 dir = r > 1e-3 ? dv / r : vec2(0.);
      float ang = atan(dir.y, dir.x);
      float dIn   = R - r;
      float edge  = smoothstep(-2.*aa - 1.5, 2.*aa + 1.5, dIn);
      float bandW = 5. + R*0.011;
      float band  = exp(-pow((dIn - (4. + R*0.018)) / bandW, 2.));
      float veil  = edge * smoothstep(0., R*0.06, dIn) * exp(-dIn / (R*0.30));
      float inner = exp(-pow((dIn - R*0.062) / (3. + R*0.006), 2.)) * edge;
      // Flank/key shading is measured from the dome. Its direction flips at the dome's exact
      // centre, which leaves a pinprick there (hidden behind the face in the study, visible over
      // the flat render here), so fade both to neutral near the centre.
      vec2  dirF  = length(p) > 1e-3 ? normalize(p) : dir;
      float nearC = smoothstep(20., 160., length(p));
      float flank = mix(0.55, 0.15 + 0.85*pow(abs(dirF.x), 1.6), nearC);
      float key   = mix(1.0, 0.80 + 0.40*max(dot(dirF, normalize(vec2(-0.6, 0.8))), 0.), nearC);
      float sheen = 0.80 + 0.20*sin(ang*3. + uSeed*2.1) * sin(ang*2. - uSeed);
      float aim   = 1. + 1.6*axisL*dot(dir, axisN);
      float light = (edge*0.30 + band*1.05 + veil*0.16 + inner*0.22) * flank * key * sheen * uEnv * aim;
      gl_FragColor = vec4(vec3(0.95, 0.96, 1.0) * clamp(light * 0.26, 0., 1.), 1.);
    }`;
  const VERT = `attribute vec2 aP; void main(){ gl_Position = vec4(aP, 0., 1.); }`;

  type Wave = { t0: number; life: number; cx: number; cy: number; ax: number; ay: number; k: number; rMax: number };
  declare global { interface Window { __adamsonWave?: Wave | null } }

  const sm = (e0: number, e1: number, x: number) => { const t = Math.min(Math.max((x - e0) / (e1 - e0), 0), 1); return t * t * (3 - 2 * t); };

  function start(canvas: HTMLCanvasElement) {
    const stage = canvas.parentElement!;
    const img = stage.querySelector<HTMLImageElement>('.speaker');
    const gl = canvas.getContext('webgl', { alpha: false, antialias: false, powerPreference: 'low-power' });
    if (!img || !gl) return;

    const sh = (t: number, s: string) => { const o = gl.createShader(t)!; gl.shaderSource(o, s); gl.compileShader(o); return o; };
    const prog = gl.createProgram()!;
    gl.attachShader(prog, sh(gl.VERTEX_SHADER, VERT)); gl.attachShader(prog, sh(gl.FRAGMENT_SHADER, FRAG));
    gl.linkProgram(prog);
    if (!gl.getProgramParameter(prog, gl.LINK_STATUS)) return;
    gl.useProgram(prog);
    gl.bindBuffer(gl.ARRAY_BUFFER, gl.createBuffer());
    gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 3, -1, -1, 3]), gl.STATIC_DRAW);
    const loc = gl.getAttribLocation(prog, 'aP'); gl.enableVertexAttribArray(loc); gl.vertexAttribPointer(loc, 2, gl.FLOAT, false, 0, 0);
    const U = (n: string) => gl.getUniformLocation(prog, n);
    const uC = U('uC'), uK = U('uK'), uR = U('uR'), uEnv = U('uEnv'), uAxis = U('uAxis'), uSeed = U('uSeed');
    gl.clearColor(0, 0, 0, 1);

    // ---- where the dome is (CSS px in the stage, y down) ----
    const dome = { x: 0, y: 0, rPx: 1, k: 1, dpr: 1 };
    // Ripple filter parts (in the panel), and how far the rim band bends the image
    const fDir = stage.querySelector('.ripple-dir'), fMask = stage.querySelector('.ripple-mask'), fDisp = stage.querySelector('.ripple-disp');
    const RIPPLE = 26;   // reference units of displacement at the rim band's peak (~20px at the frame)
    let rippling = false;
    function measure() {
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      const w = Math.max(1, Math.round(canvas.clientWidth * dpr)), h = Math.max(1, Math.round(canvas.clientHeight * dpr));
      if (canvas.width !== w || canvas.height !== h) { canvas.width = w; canvas.height = h; }
      gl.viewport(0, 0, w, h);
      // The image is rotated about its centre, so its bounding box shares that centre.
      const sr = stage.getBoundingClientRect(), ir = img.getBoundingClientRect();
      const s = img.offsetWidth / IMG_W;
      const rot = (8.46 * Math.PI) / 180;
      const lx = (DOME.x - IMG_W / 2) * s, ly = (DOME.y - IMG_H / 2) * s;
      dome.x = ir.left + ir.width / 2 - sr.left + lx * Math.cos(rot) - ly * Math.sin(rot);
      dome.y = ir.top + ir.height / 2 - sr.top + lx * Math.sin(rot) + ly * Math.cos(rot);
      dome.rPx = DOME.r * s;
      dome.k = dome.rPx / 201;        // CSS px per reference unit
      dome.dpr = dpr;

    }

    // ---- a wave on each click in the hero; the loop runs only while one is out ----
    const still = matchMedia('(prefers-reduced-motion: reduce)');
    let running = false, raf = 0, seed = 0, wave: Wave | null = null;
    function emit(now: number) {
      measure();   // the speaker floats, so find the dome where it is right now
      const [ax, ay] = AXIS;
      const W = canvas.clientWidth, H = canvas.clientHeight;
      const far = Math.max(Math.hypot(dome.x, dome.y), Math.hypot(W - dome.x, dome.y), Math.hypot(dome.x, H - dome.y), Math.hypot(W - dome.x, H - dome.y));
      wave = { t0: now, life: LIFE, cx: dome.x, cy: dome.y, ax, ay, k: dome.k, rMax: Math.max(1320, (far / dome.k) * 1.05) };
      window.__adamsonWave = wave;
      seed = (seed + 1) % 7;
    }
    function draw(now: number) {
      gl.clear(gl.COLOR_BUFFER_BIT);
      if (!wave) return;
      const f = (now - wave.t0) / 1000 / wave.life;
      if (f >= 1) { wave = null; window.__adamsonWave = null; release(); return; }
      const axisL = Math.hypot(wave.ax, wave.ay);
      const R = 196 + (wave.rMax * (1 + axisL) - 196) * Math.pow(f, 0.82);   // always clears the corners
      const env = sm(0, 0.10, f) * (1 - sm(0.45, 1, f));
      const H = canvas.height;
      gl.uniform2f(uC, wave.cx * dome.dpr, H - wave.cy * dome.dpr);
      gl.uniform1f(uK, wave.k * dome.dpr);
      gl.uniform1f(uR, R); gl.uniform1f(uEnv, env);
      gl.uniform2f(uAxis, wave.ax, wave.ay); gl.uniform1f(uSeed, seed);
      gl.drawArrays(gl.TRIANGLES, 0, 3);

      // Ripple: move and size the rim band to this ring, and bend by the wave's strength.
      const k = wave.k, rPx = R * k;
      const scx = wave.cx + wave.ax * rPx * 0.62, scy = wave.cy - wave.ay * rPx * 0.62;
      for (const fe of [fDir, fMask]) {
        fe?.setAttribute('x', (scx - rPx).toFixed(1)); fe?.setAttribute('y', (scy - rPx).toFixed(1));
        fe?.setAttribute('width', (2 * rPx).toFixed(1)); fe?.setAttribute('height', (2 * rPx).toFixed(1));
      }
      fDisp?.setAttribute('scale', (-RIPPLE * k * env).toFixed(2));
      if (!rippling) { stage.style.filter = 'url(#hero-ripple)'; rippling = true; }
    }
    function release() {
      if (!rippling) return;
      stage.style.filter = '';
      fDisp?.setAttribute('scale', '0');
      rippling = false;
    }
    function tick(now: number) {
      draw(now);
      if (wave) raf = requestAnimationFrame(tick);
      else { running = false; gl.clear(gl.COLOR_BUFFER_BIT); }
    }
    stage.addEventListener('click', (e) => {
      if ((e.target as Element).closest('a, button') || still.matches) return;   // links and buttons keep their own job
      emit(performance.now());
      if (!running) { running = true; raf = requestAnimationFrame(tick); }
    });
    // A tab switch mid-wave would leave it frozen half-way, so drop it.
    document.addEventListener('visibilitychange', () => {
      if (document.hidden && running) { cancelAnimationFrame(raf); running = false; wave = null; window.__adamsonWave = null; release(); gl.clear(gl.COLOR_BUFFER_BIT); }
    });

    measure();
    gl.clear(gl.COLOR_BUFFER_BIT);
    new ResizeObserver(measure).observe(stage);
  }

  document.querySelectorAll<HTMLCanvasElement>('canvas.sound-waves').forEach(start);
</script>
