---
// Chladni sand: bronze grains pulled onto the still (nodal) lines of a vibrating plate,
// L(x,y) = a·sin(πnx)·sin(πmy) + b·sin(πmx)·sin(πny). n, m, a, b drift slowly, so the figure
// keeps morphing; the pointer stirs the sand. With reactToWave, a SoundWaves layer in the same
// box (shared on window.__adamsonWave) also shakes it as its rim passes. Ported from the driver-face study
// (public/driver-face-webgl.html) without the driver shader or the audio,
// and in plain WebGL so the page doesn't load three.js.
// Fills its positioned parent. Runs only while on screen and the tab is visible; with reduced
// motion it draws one settled, still frame.
interface Props { opacity?: number; reactToWave?: boolean; class?: string }
const { opacity = 0.24, reactToWave = false, class: className } = Astro.props;
---

<canvas class:list={['chladni', className]} style={`--opacity:${opacity}`} data-wave={reactToWave ? '' : undefined} aria-hidden="true"></canvas>

<style>
  .chladni { position: absolute; inset: 0; width: 100%; height: 100%; display: block; pointer-events: none; opacity: 0; transition: opacity 1.2s ease; }
  /* Fades in once the sand has settled into a figure (see the script) */
  .chladni.is-ready { opacity: var(--opacity); }
</style>

<script>
  const VERT = `
    attribute vec2 aPos; attribute float aAlpha; attribute vec2 aOff;
    uniform float uSize; uniform vec2 uRes; uniform float uDpr;
    varying float vA;
    void main(){
      gl_Position = vec4(aPos + aOff * uDpr * 2. / uRes, 0., 1.);
      gl_PointSize = uSize;
      vA = aAlpha;
    }`;
  const FRAG = `
    precision mediump float;
    uniform vec3 uColor; varying float vA;
    void main(){
      vec2 c = 2. * gl_PointCoord - 1.; float d = dot(c, c);
      if (d > 1.) discard;
      float a = (1. - d) * vA;
      gl_FragColor = vec4(uColor * a, a);   // premultiplied, summed additively
    }`;

  declare global { interface Window { __adamsonWave?: { t0: number; life: number; cx: number; cy: number; ax: number; ay: number; k: number; rMax: number } | null } }

  function start(canvas: HTMLCanvasElement) {
    const gl = canvas.getContext('webgl', { alpha: true, antialias: false, premultipliedAlpha: true, powerPreference: 'low-power' });
    if (!gl) return;

    const reactToWave = canvas.hasAttribute('data-wave');
    const coarse = matchMedia('(pointer: coarse)').matches;
    const SAND = { count: coarse ? 30000 : 60000, size: 1.5, spread: 11, color: [138 / 255, 110 / 255, 75 / 255] };
    const N = SAND.count;
    const pos = new Float32Array(N * 2), vel = new Float32Array(N * 2), alp = new Float32Array(N);
    const base = new Float32Array(N), off = new Float32Array(N * 2);
    let seed32 = 0x9e3779b9;
    const rnd = () => { seed32 ^= seed32 << 13; seed32 ^= seed32 >>> 17; seed32 ^= seed32 << 5; return (seed32 >>> 0) / 4294967296; };
    for (let i = 0; i < N; i++) {
      pos[i * 2] = rnd() * 2 - 1; pos[i * 2 + 1] = rnd() * 2 - 1;
      base[i] = 0.25 + rnd() * 0.75;
      // gaussian-ish scatter so each line reads as a soft sandy band
      const ang = rnd() * Math.PI * 2;
      const rad = Math.min(Math.sqrt(-2 * Math.log(1 - rnd() * 0.9999)) * SAND.spread * 0.5, SAND.spread);
      off[i * 2] = Math.cos(ang) * rad; off[i * 2 + 1] = Math.sin(ang) * rad;
    }

    const shader = (type: number, src: string) => { const s = gl.createShader(type)!; gl.shaderSource(s, src); gl.compileShader(s); return s; };
    const prog = gl.createProgram()!;
    gl.attachShader(prog, shader(gl.VERTEX_SHADER, VERT));
    gl.attachShader(prog, shader(gl.FRAGMENT_SHADER, FRAG));
    gl.linkProgram(prog);
    if (!gl.getProgramParameter(prog, gl.LINK_STATUS)) return;
    gl.useProgram(prog);
    const attr = (name: string, data: Float32Array, size: number, usage: number) => {
      const buf = gl.createBuffer()!; const loc = gl.getAttribLocation(prog, name);
      gl.bindBuffer(gl.ARRAY_BUFFER, buf); gl.bufferData(gl.ARRAY_BUFFER, data, usage);
      gl.enableVertexAttribArray(loc); gl.vertexAttribPointer(loc, size, gl.FLOAT, false, 0, 0);
      return buf;
    };
    const posBuf = attr('aPos', pos, 2, gl.DYNAMIC_DRAW);
    const alpBuf = attr('aAlpha', alp, 1, gl.DYNAMIC_DRAW);
    attr('aOff', off, 2, gl.STATIC_DRAW);
    const uSize = gl.getUniformLocation(prog, 'uSize'), uRes = gl.getUniformLocation(prog, 'uRes'), uDpr = gl.getUniformLocation(prog, 'uDpr');
    gl.uniform3fv(gl.getUniformLocation(prog, 'uColor'), SAND.color);
    gl.enable(gl.BLEND); gl.blendFunc(gl.ONE, gl.ONE);
    gl.clearColor(0, 0, 0, 0);

    // ---- the plate and the sand ----
    const plate = { n: 3, m: 3, a: 1.2, b: 0.2, seed: 0 };
    const mouse = { x: 0, y: 0, tx: 0, ty: 0, on: false };
    let scatterTimer = 0;
    function step(dt: number) {
      const W = canvas.clientWidth || 1, H = canvas.clientHeight || 1;
      const ax = W >= H ? 1 : W / H, ay = W >= H ? H / W : 1;   // keep the figure square
      plate.seed += dt * 0.15;
      const s = plate.seed, lerp = Math.min(dt * 4, 1);
      plate.n += (3 + Math.sin(s) * 2.5 - plate.n) * lerp;
      plate.m += (3 + Math.cos(s * 1.3) * 2.5 - plate.m) * lerp;
      plate.a += (1.2 + Math.sin(s * 0.7) * 0.2 - plate.a) * lerp;
      plate.b += (0.2 + Math.cos(s * 0.5) * 0.2 - plate.b) * lerp;
      const { n, m, a, b } = plate, pn = Math.PI * n, pm = Math.PI * m;
      if (mouse.on) { const ml = Math.min(dt * 15, 1); mouse.x += (mouse.tx - mouse.x) * ml; mouse.y += (mouse.ty - mouse.y) * ml; }
      const mx = mouse.x * ax, my = mouse.y * ay;

      // The hero's current sound wave, if any (same maths as the study): its rim kicks grains
      // as it sweeps past, and the moment it leaves the dome the whole plate shakes harder.
      const w = reactToWave ? window.__adamsonWave : null;
      let shell: number[] | null = null, energy = 0;
      if (w) {
        const f = (performance.now() - w.t0) / 1000 / w.life;
        if (f >= 0 && f < 1) {
          const sm = (e0: number, e1: number, v: number) => { const t = Math.min(Math.max((v - e0) / (e1 - e0), 0), 1); return t * t * (3 - 2 * t); };
          const env = sm(0, 0.10, f) * (1 - sm(0.45, 1, f));
          energy = sm(0, 0.06, f) * (1 - sm(0.06, 0.32, f));
          const Rs = 196 + (w.rMax * (1 + Math.hypot(w.ax, w.ay)) - 196) * Math.pow(f, 0.82);
          shell = [Rs, env, w.ax * Rs * 0.62, w.ay * Rs * 0.62, w.cx, w.cy, w.k];
        }
      }

      const u = dt * 0.45;
      const pull = -2 * 0.2 * (1.2 + energy * 0.6) * u * (1.1 + energy * 1.5), pullX = pull * ax, pullY = pull * ay;
      const vib = (0.08 + energy * 0.35) * 0.045, jitBase = 0.001125;
      for (let i = 0; i < N; i++) {
        const i2 = i * 2;
        let x = pos[i2], y = pos[i2 + 1];
        const nx = x * ax, ny = y * ay;
        const snx = Math.sin(pn * nx), cnx = Math.cos(pn * nx), smy = Math.sin(pm * ny), cmy = Math.cos(pm * ny);
        const smx = Math.sin(pm * nx), cmx = Math.cos(pm * nx), sny = Math.sin(pn * ny), cny = Math.cos(pn * ny);
        const L = a * snx * smy + b * smx * sny;
        const Lx = a * pn * cnx * smy + b * pm * cmx * sny;
        const Ly = a * pm * snx * cmy + b * pn * smx * cny;
        let vx = vel[i2] + L * Lx * pullX;
        let vy = vel[i2 + 1] + L * Ly * pullY;
        if (mouse.on) {   // tangential push within a small radius
          const dx = nx - mx, dy = ny - my, d2 = dx * dx + dy * dy;
          if (d2 < 0.04) { const rep = (0.04 - d2) * 18; vx += dy * rep; vy -= dx * rep; }
        }
        vx = Math.max(-0.4, Math.min(0.4, vx)) * 0.88;
        vy = Math.max(-0.4, Math.min(0.4, vy)) * 0.88;
        vel[i2] = vx; vel[i2 + 1] = vy;
        const absL = Math.abs(L);
        let jit = jitBase + absL * vib;
        if (shell) {   // wave-front kick, in the wave's reference units (y up, from the dome)
          const px = (((x + 1) / 2) * W - shell[4]) / shell[6];
          const py = -((((1 - y) / 2) * H - shell[5]) / shell[6]);
          const ex = px - shell[2], ey = py - shell[3];
          const d = Math.sqrt(ex * ex + ey * ey) - shell[0];
          if (d > -60 && d < 8) jit += 0.006 * shell[1] * (1 - Math.abs(d + 26) / 34);
        }
        x += vx * u + (rnd() - 0.5) * jit;
        y += vy * u + (rnd() - 0.5) * jit;
        if (x > 1) x = -1; else if (x < -1) x = 1;
        if (y > 1) y = -1; else if (y < -1) y = 1;
        pos[i2] = x; pos[i2 + 1] = y;
        alp[i] = base[i] * Math.max(0.15, 1 - absL * 0.4);
      }
      // keep the figure alive: re-scatter a few grains every half second
      scatterTimer += dt;
      if (scatterTimer > 0.5) {
        scatterTimer = 0;
        for (let j = 0; j < N * 0.005; j++) {
          const k = (rnd() * N) | 0;
          pos[k * 2] = rnd() * 2 - 1; pos[k * 2 + 1] = rnd() * 2 - 1; vel[k * 2] = vel[k * 2 + 1] = 0;
        }
      }
    }
    function draw() {
      gl.bindBuffer(gl.ARRAY_BUFFER, posBuf); gl.bufferSubData(gl.ARRAY_BUFFER, 0, pos);
      gl.bindBuffer(gl.ARRAY_BUFFER, alpBuf); gl.bufferSubData(gl.ARRAY_BUFFER, 0, alp);
      gl.clear(gl.COLOR_BUFFER_BIT);
      gl.drawArrays(gl.POINTS, 0, N);
    }

    // ---- size and pixel ratio (the cap drops if frames run slow) ----
    let dprCap = 2;
    function resize() {
      const dpr = Math.min(window.devicePixelRatio || 1, dprCap);
      const w = Math.max(1, Math.round(canvas.clientWidth * dpr)), h = Math.max(1, Math.round(canvas.clientHeight * dpr));
      if (canvas.width !== w || canvas.height !== h) { canvas.width = w; canvas.height = h; }
      gl.viewport(0, 0, w, h);
      gl.uniform2f(uRes, w, h); gl.uniform1f(uDpr, dpr); gl.uniform1f(uSize, SAND.size * dpr);
      if (!running) draw();
    }

    // ---- pointer: stir the sand ----
    window.addEventListener('pointermove', (e) => {
      const r = canvas.getBoundingClientRect();
      const inside = e.clientX >= r.left && e.clientX <= r.right && e.clientY >= r.top && e.clientY <= r.bottom;
      mouse.tx = ((e.clientX - r.left) / r.width) * 2 - 1;
      mouse.ty = -(((e.clientY - r.top) / r.height) * 2 - 1);
      if (inside && !mouse.on) { mouse.x = mouse.tx; mouse.y = mouse.ty; }
      mouse.on = inside;
    }, { passive: true });

    // ---- run only when visible; reduced motion = one settled frame ----
    const still = matchMedia('(prefers-reduced-motion: reduce)');
    let inView = false, running = false, raf = 0, last = 0, frames = 0, slow = 0;
    function tick(now: number) {
      raf = requestAnimationFrame(tick);
      const dt = last ? Math.min((now - last) / 1000, 0.1) : 0;
      last = now;
      step(dt); draw();
      frames++; if (dt > 0.021) slow++;
      if (frames >= 90) { if (slow > 45 && dprCap > 1) { dprCap = Math.max(1, dprCap - 0.5); resize(); } frames = slow = 0; }
    }
    let ready = false;
    function update() {
      if (!ready) return;
      const should = inView && !document.hidden && !still.matches;
      if (should && !running) { running = true; last = 0; raf = requestAnimationFrame(tick); }
      else if (!should && running) { running = false; cancelAnimationFrame(raf); }
      if (!should) draw();
    }

    // Settle before showing anything, so the pattern is already formed, not noise. Done in short
    // chunks (about 30ms each) so the page never freezes, then the canvas fades in.
    let settled = 0;
    const SETTLE = 120;
    function settle() {
      const end = Math.min(SETTLE, settled + 8);
      for (; settled < end; settled++) step(1 / 30);
      if (settled < SETTLE) { setTimeout(settle, 0); return; }
      ready = true;
      draw();
      canvas.classList.add('is-ready');
      update();
    }
    setTimeout(settle, 0);
    resize();
    new ResizeObserver(resize).observe(canvas);
    new IntersectionObserver(([e]) => { inView = e.isIntersecting; update(); }).observe(canvas);
    document.addEventListener('visibilitychange', update);
    still.addEventListener('change', update);
  }

  document.querySelectorAll<HTMLCanvasElement>('canvas.chladni').forEach(start);
</script>
