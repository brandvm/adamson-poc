---
// Optional sound for the stack concept, synthesised with Web Audio (no files). Off until the
// visitor turns it on (browsers block audio before a click anyway). Two styles to compare,
// switched with the Pad / Arena control (the choice is remembered in this browser):
//
// Pad: a slow, soft Amaj9 pad with a breath of air in a generated reverb. Card change: the
//   compression-driver note from the driver study (thump and rising air) plus a bell per card.
//
// Arena (soundcheck in an empty venue): system hum, faint distant crowd and room tone in a
//   long arena reverb. Card change: an engineer checking the system, one test per category:
//   Loudspeakers a kick through the PA with a slap off the back wall, Electronics a sub note,
//   Software a sine sweep low to high, Immersive a sound travelling from left to right.
//
// Hero click: the thump (Pad) or the kick (Arena), with the sound wave leaving the speaker.
---

<div class="sound-ctl">
  <div class="styles" role="radiogroup" aria-label="Sound style" hidden>
    <button type="button" role="radio" data-style="pad" aria-checked="true">Pad</button>
    <button type="button" role="radio" data-style="arena" aria-checked="false">Arena</button>
  </div>
  <button class="sound" type="button" aria-pressed="false" aria-label="Sound">
    <span class="bars" aria-hidden="true"><i></i><i></i><i></i></span>
    <span class="label">Sound off</span>
  </button>
</div>

<style>
  .sound-ctl {
    position: fixed; right: 1.25em; bottom: 1.25em; z-index: 40;
    display: flex; align-items: center; gap: 0.5em;
    font: 400 0.6875em/1 var(--font); letter-spacing: 0.24em; text-transform: uppercase;
  }
  .sound, .styles {
    border: 1px solid color-mix(in srgb, var(--gold-light) 45%, transparent); border-radius: 999px;
    background: color-mix(in srgb, var(--page-bg) 45%, transparent);
    -webkit-backdrop-filter: blur(8px); backdrop-filter: blur(8px);
    transition: border-color 0.2s ease, color 0.2s ease, background-color 0.9s ease;
  }
  .sound {
    display: flex; align-items: center; gap: 0.7em; padding: 0.75em 1.1em;
    color: var(--gold-light); cursor: pointer; font: inherit; letter-spacing: inherit; text-transform: inherit;
  }
  .sound:hover { border-color: var(--gold-light); color: var(--gold); }
  .bars { display: flex; align-items: flex-end; gap: 2px; height: 10px; }
  .bars i { width: 2px; height: 3px; background: currentColor; transition: height 0.3s ease; }
  .sound[aria-pressed='true'] .bars i { animation: eq 1.1s ease-in-out infinite; }
  .sound[aria-pressed='true'] .bars i:nth-child(2) { animation-delay: -0.35s; }
  .sound[aria-pressed='true'] .bars i:nth-child(3) { animation-delay: -0.7s; }
  @keyframes eq { 0%, 100% { height: 3px; } 50% { height: 10px; } }
  @media (prefers-reduced-motion: reduce) { .sound[aria-pressed='true'] .bars i { animation: none; height: 7px; } }

  /* Pad / Arena: shown once sound is on */
  .styles { display: flex; padding: 0.25em; }
  .styles[hidden] { display: none; }
  .styles button {
    padding: 0.6em 0.9em; border: 0; border-radius: 999px; background: none; cursor: pointer;
    font: inherit; letter-spacing: inherit; text-transform: inherit; color: var(--gold-light);
    transition: background-color 0.2s ease, color 0.2s ease;
  }
  .styles button[aria-checked='true'] { background: var(--gold); color: #fff; }
</style>

<script>
  type Style = 'pad' | 'arena';
  const ctl = document.querySelector<HTMLElement>('.sound-ctl');
  if (ctl) {
    const btn = ctl.querySelector<HTMLButtonElement>('.sound')!;
    const group = ctl.querySelector<HTMLElement>('.styles')!;
    const radios = [...group.querySelectorAll<HTMLButtonElement>('button')];
    // A3, C#4, E4, G#4: one bell per card, rising through the chord the pad holds
    const NOTES = [220, 277.18, 329.63, 415.3];

    let style: Style = 'pad';
    try { if (localStorage.getItem('adamson-sound-style') === 'arena') style = 'arena'; } catch {}

    let ctx: AudioContext | null = null;
    let master: GainNode, noise: AudioBuffer;
    // Each style has its own dry bus and reverb send; the beds sit under gains we crossfade
    // (`far` is a bed level that feeds only the reverb: the arena's distant crowd)
    const S = {} as Record<Style, { bus: GainNode; verb: GainNode; bed: GainNode; far?: GainNode }>;
    let on = false;

    const impulse = (c: AudioContext, secs: number, power: number, dark = 0) => {
      const len = Math.floor(c.sampleRate * secs), ir = c.createBuffer(2, len, c.sampleRate);
      for (let ch = 0; ch < 2; ch++) {
        const d = ir.getChannelData(ch); let lp = 0;
        for (let i = 0; i < len; i++) {
          const n = Math.random() * 2 - 1;
          lp = dark ? lp + (n - lp) * (1 - dark) : n;   // one-pole low-pass for a darker tail
          d[i] = lp * (1 - i / len) ** power;
        }
      }
      return ir;
    };
    const makeStyle = (c: AudioContext, secs: number, power: number, dark: number, wetLevel: number) => {
      const conv = c.createConvolver(); conv.buffer = impulse(c, secs, power, dark);
      const verb = c.createGain(); verb.connect(conv);
      const wet = c.createGain(); wet.gain.value = wetLevel; conv.connect(wet); wet.connect(master);
      const bus = c.createGain(); bus.connect(master);
      const bed = c.createGain(); bed.gain.value = 0;
      return { bus, verb, bed };
    };

    const init = () => {
      const c = (ctx = new AudioContext());
      master = c.createGain(); master.gain.value = 0;
      const comp = c.createDynamicsCompressor();
      comp.threshold.value = -22; comp.ratio.value = 4; comp.attack.value = 0.005; comp.release.value = 0.3;
      master.connect(comp); comp.connect(c.destination);
      noise = c.createBuffer(1, c.sampleRate * 2, c.sampleRate);
      const ch = noise.getChannelData(0); for (let i = 0; i < ch.length; i++) ch[i] = Math.random() * 2 - 1;
      const loopNoise = () => { const n = c.createBufferSource(); n.buffer = noise; n.loop = true; n.loopEnd = 2; n.playbackRate.value = 0.97 + Math.random() * 0.06; n.start(0, Math.random() * 2); return n; };

      // ---- Pad: Amaj9 (A2 E3 G#3 B3 C#4), each voice two sines a few cents apart, swelling ----
      const P = (S.pad = makeStyle(c, 3.5, 3, 0, 0.55));
      P.bed.connect(P.bus); P.bed.connect(P.verb);
      const lp = c.createBiquadFilter(); lp.type = 'lowpass'; lp.frequency.value = 900; lp.Q.value = 0.5;
      const pad = c.createGain(); pad.gain.value = 0.05; lp.connect(pad); pad.connect(P.bed);
      [110, 164.81, 207.65, 246.94, 277.18].forEach((f, i) => {
        const v = c.createGain(); v.gain.value = 0.5; v.connect(lp);
        const swell = c.createOscillator(); swell.frequency.value = 0.025 + i * 0.013;
        const sg = c.createGain(); sg.gain.value = 0.4; swell.connect(sg); sg.connect(v.gain); swell.start();
        [-4, 4].forEach((cents) => { const o = c.createOscillator(); o.frequency.value = f; o.detune.value = cents; o.connect(v); o.start(); });
      });
      const lfo = c.createOscillator(); lfo.frequency.value = 0.05;
      const lg = c.createGain(); lg.gain.value = 350; lfo.connect(lg); lg.connect(lp.frequency); lfo.start();
      const alp = c.createBiquadFilter(); alp.type = 'lowpass'; alp.frequency.value = 500;
      const ag = c.createGain(); ag.gain.value = 0.018; loopNoise().connect(alp); alp.connect(ag); ag.connect(P.bed);

      // ---- Arena: a 6s dark tail, like an empty arena ----
      const A = (S.arena = makeStyle(c, 6, 2.2, 0.35, 0.7));
      A.bed.connect(A.bus);
      // System hum: 60 Hz mains and two harmonics, very low and steady, with a slight wobble
      const hum = c.createGain(); hum.gain.value = 0.012; hum.connect(A.bed);
      [[60, 1], [120, 0.5], [180, 0.25]].forEach(([f, g]) => {
        const o = c.createOscillator(); o.frequency.value = f; const og = c.createGain(); og.gain.value = g; o.connect(og); og.connect(hum); o.start();
      });
      const hw = c.createOscillator(); hw.frequency.value = 0.07; const hwg = c.createGain(); hwg.gain.value = 0.004; hw.connect(hwg); hwg.connect(hum.gain); hw.start();
      // Room tone: low rumble of the empty hall
      const rlp = c.createBiquadFilter(); rlp.type = 'lowpass'; rlp.frequency.value = 180;
      const rg = c.createGain(); rg.gain.value = 0.05; loopNoise().connect(rlp); rlp.connect(rg); rg.connect(A.bed);
      // Distant crowd: voice-band noise whose level drifts on a few slow, unrelated cycles,
      // sent almost entirely into the reverb so it sounds far away
      A.far = c.createGain(); A.far.gain.value = 0; A.far.connect(A.verb);
      [[350, 0.13, 0.9], [700, 0.21, 0.6], [1300, 0.31, 0.35]].forEach(([f, rate, lvl]) => {
        const bp = c.createBiquadFilter(); bp.type = 'bandpass'; bp.frequency.value = f; bp.Q.value = 0.9;
        const g = c.createGain(); g.gain.value = 0.012 * lvl;
        const m = c.createOscillator(); m.frequency.value = rate; const mg = c.createGain(); mg.gain.value = 0.007 * lvl;
        m.connect(mg); mg.connect(g.gain); m.start();
        loopNoise().connect(bp); bp.connect(g); g.connect(A.far!);
      });
    };

    // ---- Pad notes ----
    const thump = (t: number, level = 0.6, air = 0.07) => {
      const c = ctx!, { bus, verb } = S.pad;
      const o = c.createOscillator();
      o.frequency.setValueAtTime(130, t); o.frequency.exponentialRampToValueAtTime(42, t + 0.28);
      const g = c.createGain(); g.gain.setValueAtTime(0.0001, t);
      g.gain.exponentialRampToValueAtTime(level, t + 0.012); g.gain.exponentialRampToValueAtTime(0.0001, t + 0.7);
      o.connect(g); g.connect(bus); o.start(t); o.stop(t + 0.75);
      const n = c.createBufferSource(); n.buffer = noise;
      const bp = c.createBiquadFilter(); bp.type = 'bandpass'; bp.Q.value = 1.4;
      bp.frequency.setValueAtTime(1800, t); bp.frequency.exponentialRampToValueAtTime(6500, t + 0.5);
      const ng = c.createGain(); ng.gain.setValueAtTime(0.0001, t);
      ng.gain.exponentialRampToValueAtTime(air, t + 0.04); ng.gain.exponentialRampToValueAtTime(0.0001, t + 0.55);
      n.connect(bp); bp.connect(ng); ng.connect(bus); ng.connect(verb); n.start(t); n.stop(t + 0.6);
    };
    const bell = (f: number, t: number, level = 1) => {
      const c = ctx!, { bus, verb } = S.pad;
      [[1, 0.16 * level, 3], [2.76, 0.04 * level, 1.4]].forEach(([mul, lvl, dur]) => {
        const o = c.createOscillator(); o.frequency.value = f * mul;
        const g = c.createGain(); g.gain.setValueAtTime(0.0001, t);
        g.gain.exponentialRampToValueAtTime(lvl, t + 0.02); g.gain.exponentialRampToValueAtTime(0.0001, t + dur);
        o.connect(g); g.connect(bus); g.connect(verb); o.start(t); o.stop(t + dur + 0.05);
      });
    };

    // ---- Arena soundcheck notes ----
    const env = (g: GainNode, t: number, peak: number, attack: number, release: number) => {
      g.gain.setValueAtTime(0.0001, t);
      g.gain.exponentialRampToValueAtTime(peak, t + attack);
      g.gain.exponentialRampToValueAtTime(0.0001, t + attack + release);
    };
    // Loudspeakers: kick drum through the PA, with a slap echo off the back wall
    const kick = (t: number, level = 0.5) => {
      const c = ctx!, { bus, verb } = S.arena;
      const o = c.createOscillator();
      o.frequency.setValueAtTime(160, t); o.frequency.exponentialRampToValueAtTime(48, t + 0.12);
      o.frequency.exponentialRampToValueAtTime(40, t + 0.45);
      const g = c.createGain(); env(g, t, level, 0.004, 0.5);
      const click = c.createBufferSource(); click.buffer = noise;
      const hp = c.createBiquadFilter(); hp.type = 'highpass'; hp.frequency.value = 2500;
      const cg = c.createGain(); env(cg, t, level * 0.25, 0.001, 0.02);
      click.connect(hp); hp.connect(cg); cg.connect(g);
      // Back-wall slap: ~380ms away, darker and quieter each time
      const slap = c.createDelay(1); slap.delayTime.value = 0.38;
      const sf = c.createBiquadFilter(); sf.type = 'lowpass'; sf.frequency.value = 900;
      const fb = c.createGain(); fb.gain.value = 0.28; const sg = c.createGain(); sg.gain.value = 0.35;
      g.connect(sf); sf.connect(slap); slap.connect(fb); fb.connect(sf); slap.connect(sg); sg.connect(verb); sg.connect(bus);
      o.connect(g); g.connect(bus); g.connect(verb);
      o.start(t); o.stop(t + 0.6); click.start(t, Math.random()); click.stop(t + 0.05);
    };
    // Electronics: a long sub note (A1), with its octave so laptop speakers carry it
    const sub = (t: number) => {
      const c = ctx!, { bus, verb } = S.arena;
      [[55, 0.42], [110, 0.12]].forEach(([f, lvl]) => {
        const o = c.createOscillator(); o.frequency.value = f;
        const g = c.createGain(); g.gain.setValueAtTime(0.0001, t);
        g.gain.exponentialRampToValueAtTime(lvl, t + 0.12);
        g.gain.setValueAtTime(lvl, t + 0.9); g.gain.exponentialRampToValueAtTime(0.0001, t + 2.2);
        o.connect(g); g.connect(bus); g.connect(verb); o.start(t); o.stop(t + 2.3);
      });
    };
    // Software: a sine sweep from 40 Hz to 12 kHz, like a system being measured
    const sweep = (t: number) => {
      const c = ctx!, { bus, verb } = S.arena;
      const o = c.createOscillator();
      o.frequency.setValueAtTime(40, t); o.frequency.exponentialRampToValueAtTime(12000, t + 1.4);
      const g = c.createGain(); g.gain.setValueAtTime(0.0001, t);
      g.gain.exponentialRampToValueAtTime(0.06, t + 0.15);
      g.gain.setValueAtTime(0.06, t + 1.15); g.gain.exponentialRampToValueAtTime(0.0001, t + 1.45);
      o.connect(g); g.connect(bus); g.connect(verb); o.start(t); o.stop(t + 1.5);
    };
    // Immersive: a soft shaker-like burst plus a tone that travels left to right
    const pan = (t: number) => {
      const c = ctx!, { bus, verb } = S.arena;
      const p = c.createStereoPanner(); p.pan.setValueAtTime(-1, t); p.pan.linearRampToValueAtTime(1, t + 1.8);
      const g = c.createGain(); g.gain.setValueAtTime(0.0001, t);
      g.gain.exponentialRampToValueAtTime(1, t + 0.3); g.gain.setValueAtTime(1, t + 1.4); g.gain.exponentialRampToValueAtTime(0.0001, t + 2);
      const n = c.createBufferSource(); n.buffer = noise; n.loop = true;
      const bp = c.createBiquadFilter(); bp.type = 'bandpass'; bp.frequency.value = 2400; bp.Q.value = 1.2;
      const ng = c.createGain(); ng.gain.value = 0.09; n.connect(bp); bp.connect(ng); ng.connect(g);
      const o = c.createOscillator(); o.type = 'triangle'; o.frequency.value = 440;
      const olp = c.createBiquadFilter(); olp.type = 'lowpass'; olp.frequency.value = 1200;
      const og = c.createGain(); og.gain.value = 0.05; o.connect(olp); olp.connect(og); og.connect(g);
      g.connect(p); p.connect(bus); p.connect(verb);
      n.start(t); n.stop(t + 2.05); o.start(t); o.stop(t + 2.05);
    };

    // Card change: the sand dispatches chladni:mode (bubbling) with the card index, -1 for none
    let lastNote = -1;
    document.addEventListener('chladni:mode', ((e: CustomEvent<number>) => {
      const k = e.detail;
      if (!on || !ctx || k == null || k < 0) return;
      const t = ctx.currentTime + 0.01;
      if (t - lastNote < 0.25) return;   // fast scrolling: don't stack notes
      lastNote = t;
      if (style === 'pad') { thump(t, 0.32, 0.05); bell(NOTES[k % NOTES.length], t + 0.04, 0.7); }
      else [kick, sub, sweep, pan][k % 4](t);
    }) as EventListener);

    // Hero click: goes out with the sound wave (same rule as SoundWaves: not on links)
    document.querySelector('.hero .stage')?.addEventListener('click', (e) => {
      if (!on || !ctx || (e.target as Element).closest('a, button')) return;
      const t = ctx.currentTime + 0.01;
      if (style === 'pad') thump(t); else kick(t, 0.6);
    });

    const ramp = (p: AudioParam, to: number, s: number) => {
      const t = ctx!.currentTime;
      p.cancelScheduledValues(t); p.setValueAtTime(p.value, t); p.linearRampToValueAtTime(to, t + s);
    };
    const applyStyle = (s = 1.5) => {
      ramp(S.pad.bed.gain, style === 'pad' ? 1 : 0, s);
      ramp(S.arena.bed.gain, style === 'arena' ? 1 : 0, s);
      ramp(S.arena.far!.gain, style === 'arena' ? 1 : 0, s);
    };
    const syncRadios = () => radios.forEach((r) => {
      const sel = r.dataset.style === style;
      r.setAttribute('aria-checked', String(sel)); r.tabIndex = sel ? 0 : -1;
    });
    syncRadios();

    radios.forEach((r) => r.addEventListener('click', () => {
      style = r.dataset.style as Style;
      try { localStorage.setItem('adamson-sound-style', style); } catch {}
      syncRadios();
      if (ctx) applyStyle();
    }));
    btn.addEventListener('click', async () => {
      if (!ctx) { init(); applyStyle(0.01); }
      on = !on;
      if (on) { await ctx!.resume(); ramp(master.gain, 0.9, 1.5); }
      else { ramp(master.gain, 0, 0.6); setTimeout(() => { if (!on) ctx!.suspend(); }, 700); }
      group.hidden = !on;
      btn.setAttribute('aria-pressed', String(on));
      btn.querySelector('.label')!.textContent = on ? 'Sound on' : 'Sound off';
    });
    // Silent in a background tab
    document.addEventListener('visibilitychange', () => {
      if (!ctx || !on) return;
      if (document.hidden) ctx.suspend(); else ctx.resume();
    });
  }
</script>
