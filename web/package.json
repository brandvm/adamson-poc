{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "rm -rf .next/cache/fetch-cache && next build",
    "start": "next start",
    "lint": "eslint",
    "start:www": "next start -p 3000",
    "start:preview": "sh -c \"set -a; . ./.env.preview; set +a; exec next start -p 3001\"",
    "dev:preview": "sh -c \"set -a; . ./.env.preview; set +a; NEXT_DIST_DIR=.next-preview exec next dev -p 3001\""
  },
  "dependencies": {
    "gsap": "^3.15.1",
    "lenis": "^1.3.28",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "typescript": "^5"
  }
}
